# Admin API key (x-api-key header) for admin endpoint authentication
ADMIN_API_KEY=replace-with-your-admin-api-key

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here

# PostgreSQL Databases
# Vector database for RAG embeddings (with pgvector extension)
VECTOR_DB_CONNECTION_STRING=postgresql://user:password@host:10033/vectordb

# State database for conversation history (no special extensions needed)
CONVERSATION_DB_CONNECTION_STRING=postgresql://user:password@host:10033/statedb

# Linode Object Storage Configuration
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=langchain-documents
# http[s]:// at the beginning of endpoint is optional
S3_ENDPOINT=us-sea-1.linodeobjects.com

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional: Logging Configuration
LOG_LEVEL=INFO
