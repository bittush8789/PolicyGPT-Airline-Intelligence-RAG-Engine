# Admin API key (x-api-key header) for admin endpoint authentication
ADMIN_API_KEY=admin-secret-key-123

# Groq Configuration (Ultra-fast LLM inference)
# Obtain a key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# LLM and Embedding Model Configuration
# Model: openai/gpt-oss-120b hosted on Groq LPU
LLM_MODEL=openai/gpt-oss-120b
# Local FastEmbed model (runs inside the container, no API key required)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# PostgreSQL Databases (Local Docker Compose stack with pgvector)
VECTOR_DB_CONNECTION_STRING=postgresql://postgres:postgrespassword@postgres:5432/vectordb
CONVERSATION_DB_CONNECTION_STRING=postgresql://postgres:postgrespassword@postgres:5432/statedb

# Local Documents Directory
DOCUMENTS_DIR=/app/documents

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging Configuration
LOG_LEVEL=INFO
